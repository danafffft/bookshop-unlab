# Copy to .env and replace every CHANGE_ME value.
DB_PASSWORD=CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_LONG_RANDOM_ADMIN_PASSWORD
PUBLIC_ORIGIN=http://localhost:8080
# Use true with a production HTTPS origin.
COOKIE_SECURE=false
